# Variables du serveur de développement Vite.
# Copier en `.env` et ajuster. Aucune valeur secrète ici : le front est public
# par construction, tout ce qu'on y met finit dans le navigateur.

# Hôte de l'API visé par le proxy /api du serveur de développement.
#   - hors conteneur (npm run dev sur la machine) : http://127.0.0.1:8000
#   - dans Docker (front et API dans le même réseau) : http://api:8000
# En production, ce proxy ne sert pas : c'est nginx qui relaie (voir nginx.conf).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Interface et port d'écoute du serveur de développement.
# 127.0.0.1 par défaut : une application familiale n'a pas à s'exposer au
# réseau du logement. Mettre 0.0.0.0 uniquement pour servir depuis un conteneur.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
