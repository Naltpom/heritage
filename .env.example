# =============================================================================
#  Heritage — variables d'orchestration
# =============================================================================
#
# Ce fichier est un MODÈLE versionné. Il ne contient que des valeurs de
# développement, inoffensives et publiques : elles ne protègent qu'une base
# locale jetable, et le fait qu'elles soient lisibles par quiconque cloue le
# dépôt est assumé.
#
#   Développement  →  rien à faire. compose.yaml embarque exactement ces
#                     valeurs comme replis, `docker compose up --build` suffit.
#                     Copiez ce fichier en `.env` seulement si vous voulez
#                     changer un port ou l'adresse d'écoute.
#
#   Production     →  `cp .env.example .env`, PUIS remplacer une par une les
#                     variables marquées « ⚠ À REMPLACER » et renseigner celles
#                     marquées « ⚠ PRODUCTION SEULEMENT », laissées vides ici.
#                     Le service `garde-secrets` de compose.prod.yaml interrompt
#                     le démarrage tant que ce n'est pas fait — il ne vérifie pas
#                     que les valeurs sont bonnes, seulement qu'elles ne sont
#                     plus celles du développement, et que les quatre variables
#                     qui portent le domaine désignent bien le MÊME domaine.
#
#                     La procédure complète de première mise en ligne, avec les
#                     valeurs à mettre dans chaque champ et les mesures de
#                     contrôle, est dans `docs/deploiement/premiere-mise-en-ligne.md`.
#
# `.env` est dans le .gitignore. Aucune valeur réelle ne doit remonter ici.
#
# Portée : ce fichier est lu par Docker Compose, pas par Symfony. La
# configuration interne de l'API vit dans `api/.env` ; les variables que
# Compose définit (DATABASE_URL, MAILER_DSN, APP_SECRET) l'emportent sur elle,
# puisque Symfony fait toujours gagner l'environnement réel sur ses fichiers.
# =============================================================================


# -----------------------------------------------------------------------------
#  Exposition réseau
# -----------------------------------------------------------------------------
#
# Si vous touchez à ces quatre ports parce qu'une pile JETABLE entre en conflit
# avec la pile de travail : ne les changez pas ici. Un .env modifié vaut pour
# tout le monde, et la pile de travail repartirait sur d'autres ports sans que
# personne l'ait décidé. Posez-les dans votre shell, avec le nom de projet qui
# va avec — la marche à suivre est en tête de compose.yaml, section « AVANT DE
# MONTER UNE PILE JETABLE ». C'est un `docker compose down` sans nom de projet
# qui a détruit la pile de travail le 15 septembre 2026.

# Interface sur laquelle les ports sont publiés.
# 127.0.0.1 : accessible depuis cette machine seulement. C'est le défaut, et il
# est délibéré — l'application porte l'état civil de 18 personnes vivantes, elle
# n'a rien à faire sur le réseau d'un logement ou d'un lieu public.
# 0.0.0.0 ouvre à tout le réseau local : à ne mettre que le temps d'un essai
# depuis un téléphone, jamais durablement. En production, compose.prod.yaml
# ignore cette variable et force 127.0.0.1.
BIND_ADDR=127.0.0.1

# Front (nginx : la SPA + le relais /api). C'est l'URL qu'on ouvre.
#
# SUR LE VPS heritage.naltpom.fr, CE N'EST PAS 8080 : c'est 5511. Deux raisons,
# et la première suffit — 8080 y est DÉJÀ PRIS par un autre projet (pgadmin de
# tajemajerush, publié sur 0.0.0.0:8080), le `up` échouerait au bind avec un
# « address already in use » que rien ne rattache à ce fichier. La seconde est la
# convention du serveur : une paire de ports par application, sur la boucle
# locale, attribuée dans l'ordre — certivio 5471, sitter 5481, pokemon 5491,
# learnly 5501, et donc heritage 5511. Heritage n'a besoin que d'UN port (le
# front relaie /api lui-même), 5512 reste libre.
APP_PORT=8080

# API seule, sans passer par nginx. Sert à la mise au point (curl, client REST)
# et au `npm run dev` lancé hors conteneur : app/.env.example vise déjà
# http://127.0.0.1:8000. Non publié en production.
API_PORT=8000

# PostgreSQL, pour un client SQL du poste (psql, DBeaver). Non publié en
# production. Changez-le s'il entre en conflit avec un PostgreSQL déjà installé.
DB_PORT=5432

# Interface de consultation de Mailpit : les invitations envoyées en
# développement y atterrissent au lieu de partir pour de vrai.
MAILPIT_UI_PORT=8025


# -----------------------------------------------------------------------------
#  Base de données
# -----------------------------------------------------------------------------

POSTGRES_DB=heritage
POSTGRES_USER=heritage

# ⚠ À REMPLACER AVANT TOUTE EXPOSITION (production, VPS, réseau ouvert).
# Un mot de passe long et propre à la machine : `openssl rand -base64 24`.
# Celui-ci est public, il est écrit dans un dépôt Git.
POSTGRES_PASSWORD=heritage_dev


# -----------------------------------------------------------------------------
#  API
# -----------------------------------------------------------------------------

# ⚠ À REMPLACER AVANT TOUTE EXPOSITION.
# Clé de signature de Symfony : elle scelle les cookies de session, les jetons
# de formulaire et les liens signés. Si elle fuit, un tiers forge une session
# d'administrateur — le mot de passe de la base n'est même plus nécessaire.
# Générer : `openssl rand -hex 32`. Ne se partage pas entre deux machines.
APP_SECRET=d3v3l0ppement_secret_local_jetable

# ⚠ À REMPLACER AVANT TOUTE EXPOSITION.
# SMTP qui porte les invitations. En développement, `smtp://mailpit:1025` capte
# tout et n'envoie rien : c'est ce qui garantit qu'aucun essai ne fait partir un
# courriel vers une adresse réelle de la famille.
# En production : le DSN du fournisseur, par exemple
#   smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# `null://null` reste valable si l'on assume de ne distribuer les invitations
# que par copie manuelle du lien depuis l'administration.
MAILER_DSN=smtp://mailpit:1025

# ⚠ PRODUCTION SEULEMENT — vide ici, EXIGÉE par le `garde-secrets`.
# L'adresse `From:` des courriels d'invitation.
#
# Vide, `api/config/services/membership.yaml` retombe sur
# `app.membership.expediteur_par_defaut` = `heritage@localhost`, que
# `EnvoiDInvitation` pose tel quel. Aucun relais sérieux n'accepte un expéditeur
# en `localhost` : le message est rejeté par le serveur sortant, ou accepté puis
# classé en indésirable. Dans les deux cas l'administrateur voit « invitation
# envoyée » et le destinataire ne reçoit rien.
#
# L'adresse doit être AU DOMAINE dont SPF/DKIM/DMARC sont publiés — un `From:`
# d'un domaine qu'on n'autorise pas soi-même est le premier motif de classement
# en indésirable. Le libellé entre chevrons est facultatif.
# En production :  MAILER_EXPEDITEUR='Heritage <invitations@heritage.exemple.fr>'
MAILER_EXPEDITEUR=

# ⚠ À REMPLACER AVANT TOUTE EXPOSITION.
# Base des URL construites hors contexte HTTP, donc des LIENS D'INVITATION
# envoyés par courriel. Doit désigner le front public, en https en production.
# Une valeur fausse produit des liens morts, et une invitation est à usage
# unique : le lien est brûlé avant même d'avoir servi.
# Si vous changez APP_PORT, changez ce port ici aussi.
DEFAULT_URI=http://localhost:8080

# ⚠ PRODUCTION SEULEMENT — vide ici, EXIGÉE par le `garde-secrets`.
# Base des LIENS D'INVITATION, lue par `Core\Service\UrlPublique`.
#
# CE N'EST PAS UN DOUBLON DE DEFAULT_URI, et c'est le piège qui a coûté le plus
# cher. `DEFAULT_URI` règle le routeur de Symfony ; c'est celle-ci, et elle seule,
# qui fabrique l'URL mise dans le courriel d'invitation. Elle n'était injectée
# NULLE PART en production : le conteneur retombait alors sur `api/.env`, copié
# dans l'image, où elle vaut `http://localhost:8080`. La pile démarrait,
# annonçait « configuration vérifiée », et chaque invitation partait vers
# localhost. Le destinataire clique, rien ne répond, et le jeton — à usage
# unique — est consommé. L'invitation ne se rejoue pas : il faut la réémettre.
#
# En développement, laisser vide : `api/.env` porte la bonne valeur locale, et
# compose.yaml n'injecte pas cette variable.
# En production :  HERITAGE_URL_PUBLIQUE=https://heritage.exemple.fr
HERITAGE_URL_PUBLIQUE=

# ⚠ PRODUCTION SEULEMENT — vide ici, EXIGÉE par le `garde-secrets`.
# Le domaine SEUL, sans schéma ni chemin. Il est substitué dans le `server_name`
# du bloc applicatif d'`app/nginx.conf`, qui est un gabarit monté par
# compose.prod.yaml dans `/etc/nginx/templates/`.
#
# Vide en production, le front ne nomme que `localhost` — et comme le premier
# bloc du fichier est un `return 444`, toute requête portant le domaine réel y
# tombe et la connexion se ferme SANS RÉPONSE. Panne totale, aucun journal.
# En production :  HERITAGE_DOMAINE_PUBLIC=heritage.exemple.fr
HERITAGE_DOMAINE_PUBLIC=

# ⚠ PRODUCTION SEULEMENT — vide ici, EXIGÉE par le `garde-secrets`.
# Les seuls `Host` que l'API accepte de servir (`framework.trusted_hosts`).
# Expressions régulières ANCRÉES, séparées par des virgules.
#
# LES ANCRES NE SONT PAS DÉCORATIVES et ne sont pas ajoutées pour vous :
# `heritage\.exemple\.fr` sans `^` ni `$` accepte
# `heritage.exemple.fr.attaquant.test`, c'est-à-dire exactement le trou que cette
# liste est censée fermer. Le garde-fou refuse une valeur non ancrée.
#
# Les points sont échappés : dans une expression régulière, `.` vaut n'importe
# quel caractère.
# En production :  HERITAGE_HOTES_AUTORISES='^heritage\.exemple\.fr$'
HERITAGE_HOTES_AUTORISES=

# Environnement Symfony du conteneur d'API, `prod` par défaut — en accord avec
# l'étage d'image construit (`target: prod` dans compose.yaml). Les fixtures
# anonymisées se chargent malgré tout : config/bundles.php enregistre
# DoctrineFixturesBundle en 'all'.
#
# `API_APP_ENV=dev` suffit, SANS reconstruire, pour obtenir les pages d'erreur
# détaillées de Symfony à la place du « Internal Server Error » opaque du mode
# production. Utile dès qu'on écrit un contrôleur.
#
# Les OUTILS de développement (maker-bundle, phpstan, phpunit dans le conteneur)
# demandent en plus `target: dev` dans le `build:` du service `api` de
# compose.yaml, donc une reconstruction — et alors les deux vont ensemble.
#
# La cible de construction n'est volontairement pas pilotable par variable : une
# valeur d'environnement ne doit pas pouvoir décider de ce qui est construit, et
# la production la déclare en dur de son côté.
API_APP_ENV=prod


# -----------------------------------------------------------------------------
#  Chemins applicatifs
# -----------------------------------------------------------------------------

# Chemin du GEDCOM à importer (commande `heritage:import-gedcom`).
# Laisser VIDE par défaut : ce fichier vit dans C:\www\myHeritage, l'atelier
# généalogique, qui n'existe ni sur une autre machine ni sur un VPS. Un chemin
# en dur donnerait une commande qui échoue avec un message obscur, là où une
# variable vide donne un « Aucun fichier GEDCOM indiqué » clair.
#
# PIÈGE EN CONTENEUR : ce chemin est lu PAR L'API, donc DANS le conteneur. Un
# chemin de l'hôte Windows (`C:/www/myHeritage/...`) n'y désigne rien. Deux
# façons de faire, au choix :
#   - copier le fichier puis l'importer, sans rien monter :
#       docker compose cp C:/www/myHeritage/arbre-romarin-v5.ged api:/tmp/a.ged
#       docker compose exec api php bin/console heritage:import-gedcom /tmp/a.ged
#   - ou monter l'atelier en lecture seule (bloc commenté dans compose.yaml,
#     service `api`) et écrire ici un chemin du conteneur :
#       GEDCOM_FILE=/atelier/arbre-romarin-v5.ged
# L'atelier est en LECTURE SEULE : on ne l'écrit jamais depuis l'application.
GEDCOM_FILE=

# Racine du stockage des médias — portraits et preuves — DANS le conteneur.
# Laisser vide : l'API retombe alors sur `%kernel.project_dir%/uploads`, soit
# /app/uploads, exactement là où compose.yaml monte le volume nommé
# `televersements`. À ne renseigner que si le volume est monté ailleurs (VPS
# avec un disque dédié). Le stockage doit rester HORS racine web : les médias
# sont servis par une route authentifiée qui applique le cercle de visibilité.
MEDIA_RACINE=


# -----------------------------------------------------------------------------
#  Images
# -----------------------------------------------------------------------------

# Les images construites sont nommées <IMAGE_PREFIX>/api et <IMAGE_PREFIX>/app.
IMAGE_PREFIX=heritage

# Étiquette des images. En production, figez-la sur une version datée
# (IMAGE_TAG=2026-09-15) plutôt que de laisser flotter `prod` : c'est ce qui
# permet de revenir à l'image précédente sans la reconstruire.
#
# SUR LE VPS, NE LA RENSEIGNEZ PAS À LA MAIN : le flux `.github/workflows/deploy.yml`
# l'écrit lui-même à chaque déploiement, avec l'empreinte courte du commit
# déployé (`IMAGE_TAG=a1b2c3d`). C'est ce qui rend le retour arrière possible
# SANS reconstruction : l'image du déploiement précédent porte encore sa propre
# étiquette et n'a été écrasée par personne. Une étiquette fixe (`prod`) serait
# réécrite à chaque build, et il n'y aurait plus rien où revenir.
IMAGE_TAG=dev


# -----------------------------------------------------------------------------
#  Sauvegardes (production uniquement)
# -----------------------------------------------------------------------------
# Lues par le service `sauvegarde` de compose.prod.yaml. Sans effet en
# développement, où ce service n'existe pas.

# Dossier de l'hôte où sont déposés le dump de la base et l'archive des
# téléversements. Montage d'hôte volontaire : une sauvegarde enfermée dans un
# volume Docker ne part nulle part. Déjà couvert par le .gitignore.
BACKUP_DIR=./backups

# Intervalle entre deux passages, en secondes. 86400 = une fois par jour.
BACKUP_INTERVAL=86400

# Durée de conservation, en jours. Au-delà, les archives sont effacées.
# Comptez la place : un dump de 274 personnes est minuscule, mais les preuves
# scannées ne le sont pas.
BACKUP_RETENTION_DAYS=14

# ── La page « Questions » (ADR 0008) ────────────────────────────────────────
#
# Un modèle de langage FORMULE les questions que la détection a trouvées ; il
# n'en ouvre aucune et n'en ferme aucune.
#
# **Laisser vide est un état normal**, pas une panne : aucun appel ne part, le
# repli par gabarits rédige, et la page sert les mêmes questions — moins bien
# tournées. Rien ne rougit.
#
# Le palier visé est le **payant / Vertex**, jamais le gratuit : ses conditions
# excluent la réutilisation des données pour l'entraînement, et le corpus
# transmis nomme des personnes vivantes.
#
# ⚠ Ces trois lignes n'ont d'effet que parce que `compose.yaml` les reprend dans
# le bloc `environment:` du service `api`. Les deux vont ensemble.
HERITAGE_GEMINI_CLE_API=
HERITAGE_GEMINI_MODELE=
HERITAGE_GEMINI_POINT_DACCES=
# L'assistant « Proposer avec l'assistant » réutilise la même clé et le même
# point d'accès ; seul son modèle diffère. Vide = `gemini-pro-latest`, l'alias du
# dernier modèle Pro servi (`gemini-2.5-pro` rend `404` aux clés récentes).
HERITAGE_GEMINI_MODELE_ASSISTANT=
