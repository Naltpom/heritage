###> symfony/framework-bundle ###
# Secret du mode `dev` UNIQUEMENT. Symfony ne charge ce fichier que si APP_ENV=dev :
# la pile Docker tourne en `prod` et prend son APP_SECRET de `compose.yaml`, donc
# cette valeur n'est JAMAIS celle en service. Elle ne sert qu'au `php -S` local sur
# SQLite. Versionnée délibérément (voir `api/.gitignore:38-39`) : sans elle, un clone
# neuf ne démarre pas en dev. Ne jamais y mettre un secret réel.
APP_SECRET=3e9ca3222b5f6e75d3300d85469c98a4
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Développement local sans Docker : SQLite, zéro configuration et aucune extension
# pdo_pgsql à installer sur le poste. En conteneur, Compose impose DATABASE_URL vers
# PostgreSQL et l'emporte sur cette ligne (une vraie variable d'environnement gagne).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_dev.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailpit, quand la pile Docker tourne :
#MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###
