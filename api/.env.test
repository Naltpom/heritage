# Variables propres à l'environnement de test.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# SQLite : les tests doivent tourner sans base externe ni conteneur.
#
# CETTE LIGNE N'EST QU'UN REPLI. `tests/bootstrap.php` la remplace, avant l'amorçage
# du noyau, par un fichier suffixé du numéro de processus — plusieurs suites tournent
# en même temps sur la machine de développement, et un fichier commun leur faisait
# rendre « table already exists » et « no such table » à tour de rôle. Ce fichier-ci
# ne sert donc qu'à ce qui ne passe pas par le bootstrap, par exemple
# `bin/console --env=test`.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_test.db"

# Aucun courriel ne part d'un test.
MAILER_DSN=null://null
